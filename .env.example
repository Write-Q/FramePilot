# 本机填写真实值；不要提交 .env 或把密钥发到聊天中。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 互动故事的可选生图网关，须符合 docs/story-game.md 中的HTTP契约。
# 未配置时文字玩法可用；修改后重启。不要提交真实密钥。
GAME_IMAGE_API_URL=
GAME_IMAGE_API_KEY=
GAME_IMAGE_MODEL=

# 分镜图片配置填写此环境变量名；API地址/型号在工作台单独设置。
# 尚未选择服务时留空。与互动故事生图配置独立。
STORYBOARD_IMAGE_API_KEY=
# 火山方舟图片/视频共享的本机密钥；工作台仅填写变量名 ARK_API_KEY。
# 手动配置后重启 Web 和 worker；不会自动开通或充值服务。
ARK_API_KEY=
# Web和独立media_worker必须使用同一持久化目录；默认项目data/media。
# FRAMEPILOT_MEDIA_ROOT=D:/FramePilot-media
# 视频候选文件目录，Web与视频worker需一致；默认data/video。
# FRAMEPILOT_VIDEO_ROOT=D:/FramePilot-video

# docker compose 使用此密码；请自行替换，且同步修改下面 URL 中的密码。
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://framepilot:replace-with-a-random-password@127.0.0.1:5433/framepilot
# 测试需要可创建临时数据库的账号；绝不直接清空这个连接所指向的库。
# TEST_DATABASE_URL=postgresql+psycopg://framepilot:your-password@127.0.0.1:5433/framepilot
